#!/bin/sh
# Reload the agent whenever the plist changes.
# plist hash: {{ include "private_Library/LaunchAgents/se.unbound.gobuildcache-trim.plist" | sha256sum }}

plist="$HOME/Library/LaunchAgents/se.unbound.gobuildcache-trim.plist"
launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null
launchctl bootstrap "gui/$(id -u)" "$plist"
